# Скопируйте в deploy.env и подставьте свои значения: cp deploy.env.example deploy.env
TP_SERVER=root@203.0.113.10          # куда деплоим
TP_DOMAIN=crm.example.com            # домен, на него выпускается сертификат
TP_REMOTE_DIR=/opt/technoprint
TP_DB_PASSWORD=смените_меня          # пароль PostgreSQL
TP_TG_BOT_TOKEN=                     # токен бота от @BotFather, можно оставить пустым
TP_ADMIN_EMAIL=admin@example.com     # почта для Let's Encrypt
