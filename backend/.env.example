# Скопируйте в backend/.env. Файл с реальными значениями в репозиторий не попадает.
DATABASE_URL=postgresql+asyncpg://technoprint:смените_меня@tp-db:5432/technoprint
SECRET_KEY=                # обязательно: openssl rand -hex 32
BANK_COMMISSION=0.01       # комиссия эквайринга, доля
CARD_COMMISSION=0.013
TG_BOT_TOKEN=              # бот уведомлений, необязательно
TG_ADMIN_CHAT_ID=          # chat_id владельца, узнаётся по /start
INTERNAL_TOKEN=            # токен для служебных вызовов бота
